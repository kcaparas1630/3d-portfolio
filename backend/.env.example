# Supabase Configuration
# Required: Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Required: Your Supabase service role key (for server-side operations)
# Get this from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_KEY=your-service-role-key-here

# Table Names (optional - defaults shown)
RAW_DATA_TABLE=raw_data
TRAINING_DATA_TABLE=training_data

# Pipeline Configuration (optional - defaults shown)
# Window size in days for calculating moving averages
MOVING_AVERAGE_WINDOW=7

# Batch size for database read/write operations
BATCH_SIZE=1000

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
